---
import { entrainements } from '../data/pelerinage';
---

<section id="entrainements" class="scroll-mt-20 bg-rose-clair py-10 sm:py-14">
  <div class="mx-auto max-w-3xl px-5 text-center">
    <h2 class="display text-3xl text-rose-fonce sm:text-4xl">{entrainements.titre}</h2>

    <p class="mx-auto mt-3 max-w-2xl text-lg leading-relaxed text-encre/70">
      {entrainements.texte}
    </p>

    <div class="mt-6 flex flex-wrap justify-center gap-3">
      {
        entrainements.dates.map((date) => (
          <span class="rounded-full bg-white px-5 py-2.5 text-lg font-semibold text-rose-fonce">
            {date}
          </span>
        ))
      }
    </div>
  </div>
</section>
