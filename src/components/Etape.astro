---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  surtitre: string;
  heure: string;
  lieu: string;
  adresse: string;
  lienCarte: string;
  libelleLien: string;
  image: ImageMetadata;
  alt: string;
  inverse?: boolean;
}

const { id, surtitre, heure, lieu, adresse, lienCarte, libelleLien, image, alt, inverse = false } =
  Astro.props;
---

<section id={id} class="scroll-mt-20 py-16 sm:py-24">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 md:grid-cols-2 md:gap-14">
    <div class={inverse ? 'md:order-2' : ''}>
      <Image
        src={image}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes="(max-width: 768px) 100vw, 560px"
        class="aspect-4/3 w-full rounded-2xl object-cover"
        loading="lazy"
      />
    </div>

    <div class={inverse ? 'md:order-1' : ''}>
      <h2 class="display text-3xl text-rose-fonce sm:text-4xl">{surtitre}</h2>

      <p class="display mt-6 text-5xl text-encre sm:text-6xl">{heure}</p>

      <p class="mt-4 text-xl font-semibold text-encre">{lieu}</p>
      <p class="mt-1 text-lg text-encre/65">{adresse}</p>

      <a
        href={lienCarte}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 text-base font-semibold text-rose-fonce underline decoration-rose decoration-2 underline-offset-4 hover:decoration-rose-fonce"
      >
        {libelleLien}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
