---
import { Image } from 'astro:assets';
import banniere from '../assets/banniere.jpg';
import { site, edition, chiffres } from '../data/pelerinage';
import Bouton from './Bouton.astro';
---

<!--
  Toute la section rose tient sur une hauteur d'écran : elle occupe au minimum
  la fenêtre moins l'en-tête, et son contenu y est centré. C'est la hauteur du
  bandeau qui est bornée (34 % de la hauteur d'écran, plafonné à 420 px pour ne
  pas devenir démesuré sur un grand moniteur) ; le texte, lui, garde sa taille.
  `svh` tient compte de la barre d'adresse mobile, et `min-h` cède si le
  contenu ne rentre vraiment pas : rien n'est jamais tronqué.
-->
<section
  id="top"
  class="flex hero min-h-[calc(100svh-4.5rem)] flex-col items-center justify-center gap-8 bg-rose px-5 py-8"
>
  <Image
    src={banniere}
    alt="Pèlerinage cycliste — de Paris à Chartres à vélo"
    widths={[480, 640, 960]}
    sizes="(max-width: 640px) 100vw, 620px"
    class="hero-bandeau max-h-[min(34svh,420px)] w-auto max-w-full object-contain"
    loading="eager"
    fetchpriority="high"
  />

  <div class="max-w-3xl text-center">
    <h1 class="hero-titre display text-3xl text-white sm:text-4xl md:text-5xl">
      {edition.accroche}
    </h1>

    <p class="hero-marge mt-5 text-lg text-white/95 sm:text-xl">
      {edition.annonce}
    </p>
    <p class="display mt-2 text-2xl text-white sm:text-3xl">
      <time datetime={edition.dateISO}>{edition.date}</time>
    </p>

    <p
      class="hero-marge mt-5 inline-block rounded-full bg-white/25 px-5 py-2 text-sm font-semibold tracking-wide text-white uppercase"
    >
      {edition.statutInscriptions}
    </p>

    <div class="hero-marge mt-5">
      <Bouton href={site.lienInscription} variante="blanc">Inscrivez-vous !</Bouton>
    </div>
  </div>
</section>

<section aria-label="Le pèlerinage en chiffres" class="border-b border-rose-clair bg-rose-clair">
  <dl class="mx-auto grid max-w-5xl grid-cols-2 gap-px px-5 py-10 sm:gap-8 md:grid-cols-4">
    {
      chiffres.map((chiffre) => (
        <div class="min-w-0 px-2 py-3 text-center">
          <dt class="display text-3xl text-rose-fonce sm:text-4xl">{chiffre.valeur}</dt>
          <dd class="mt-1.5 text-sm text-encre/65">{chiffre.libelle}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  /*
    Sur un écran bas — portable 13 pouces, fenêtre réduite, téléphone en
    paysage — le bandeau seul ne suffit plus à absorber la différence : le bloc
    de texte mesure 361 px à taille normale, ce qui dépassait de 48 px sur une
    fenêtre de 725 px. On resserre donc titre et interlignes en dessous de
    800 px de hauteur. Media query sur la hauteur, et non sur la largeur : c'est
    bien la place verticale qui manque.
  */
  @media (max-height: 800px) {
    .hero {
      gap: 1.5rem;
      padding-block: 1.25rem;
    }

    .hero-titre {
      font-size: 1.875rem;
      line-height: 1.1;
    }

    .hero-marge {
      margin-top: 0.75rem;
    }
  }

  @media (max-height: 640px) {
    .hero-bandeau {
      max-height: 26svh;
    }
  }
</style>
