---
import { faq } from '../data/pelerinage';

// Le groupe capturant fait que split() garde les URL aux indices impairs.
const URL = /(https?:\/\/[^\s)]+)/;
---

<section id="faq" class="scroll-mt-20 bg-rose-clair py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-5">
    <h2 class="display text-center text-3xl text-rose-fonce sm:text-4xl">{faq.titre}</h2>

    {
      faq.rubriques.map((rubrique) => (
        <div class="mt-12">
          <h3 class="display text-2xl text-encre">{rubrique.titre}</h3>

          <div class="mt-5 space-y-3">
            {rubrique.questions.map((item) => (
              <details class="group rounded-2xl bg-white">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-lg font-semibold text-encre [&::-webkit-details-marker]:hidden">
                  {item.question}
                  <span
                    class="flex size-6 shrink-0 items-center justify-center rounded-full bg-rose text-sm font-bold text-white transition-transform group-open:rotate-45"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>

                <div class="px-5 pb-5 text-lg leading-relaxed text-encre/80">
                  {item.reponse && (
                    <p>
                      {item.reponse.split(URL).map((morceau, index) =>
                        index % 2 === 1 ? (
                          <a
                            href={morceau}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="font-semibold text-rose-fonce underline underline-offset-4"
                          >
                            {morceau.replace(/^https?:\/\//, '')}
                          </a>
                        ) : (
                          morceau
                        ),
                      )}
                    </p>
                  )}
                  {item.liste && (
                    <ul class="list-disc space-y-1 pl-5 marker:text-rose">
                      {item.liste.map((element) => (
                        <li>{element}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
