---
import { site, navigation } from '../data/pelerinage';
const annee = new Date().getFullYear();
---

<footer class="bg-white py-12">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-5 text-center md:flex-row md:justify-between md:text-left"
  >
    <div>
      <p class="display text-xl text-rose-fonce">{site.nom}</p>
      <a
        href={`mailto:${site.email}`}
        class="mt-1 inline-block text-sm text-encre/60 hover:text-rose-fonce"
      >
        {site.email}
      </a>
    </div>

    <nav aria-label="Pied de page" class="flex flex-wrap justify-center gap-x-6 gap-y-2">
      {
        navigation.map((lien) => (
          <a href={lien.href} class="text-sm text-encre/60 hover:text-rose-fonce">
            {lien.libelle}
          </a>
        ))
      }
    </nav>

    <p class="text-sm text-encre/45">© {annee} — {site.nom} Paris — Chartres</p>
  </div>
</footer>
